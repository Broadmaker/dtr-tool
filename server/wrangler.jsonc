{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dtr-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dtr-db",
      "database_id": "caec0cd1-fd06-4c9d-8639-98c25a8cf781",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://dtr-tool.pages.dev",
    "APP_ORIGIN": "https://dtr-tool.pages.dev"
  }
}
