{
  "name": "dtr-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-port.mjs",
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply dtr-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply dtr-db --remote",
    "admin:grant:local": "node scripts/grant-admin.mjs --local",
    "admin:grant:remote": "node scripts/grant-admin.mjs --remote",
    "auth:generate": "auth generate --config scripts/auth-schema.ts --output migrations/0001_better_auth.sql"
  },
  "dependencies": {
    "better-auth": "^1.7.11",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/better-sqlite3": "^7.6.13",
    "auth": "^1.7.11",
    "better-sqlite3": "^13.0.3",
    "typescript": "~6.0.2",
    "wrangler": "^4.151.2"
  }
}
